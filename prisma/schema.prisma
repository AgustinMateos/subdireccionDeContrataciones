// Schema de base de datos real, pensado para Postgres (Vercel Postgres / Neon / Supabase).
// Reemplaza los arrays hardcodeados de lib/constants.js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Departamentos ----------

model Departamento {
  id     String @id @default(cuid())
  nombre String @unique // "Informática y Varios" | "Servicios"
  slug   String @unique // "informatica-y-varios" | "servicios"

  usuarios    Usuario[]
  expedientes Expediente[]
}

// ---------- Usuarios y autenticación ----------

enum Rol {
  admin
  operador
  lector
  soporte
}

model Usuario {
  id             String       @id @default(cuid())
  nombre         String
  email          String       @unique
  passwordHash   String
  rol            Rol
  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  creadoEn       DateTime     @default(now())

  @@index([departamentoId])
}

// ---------- Expedientes ----------

enum Area {
  Informatica
  Varios
}

enum RolCadena {
  antecedente
  vigente
  parche
  renovacion
}

model Expediente {
  id                 String       @id @default(cuid())
  cadenaId           String // agrupa antecedente/vigente/parche/renovación de un mismo trámite
  rol                RolCadena
  exp                String       @unique // "13-06148/26"
  nombreCorto        String? // alias legible para identificar y filtrar rápido ("Limpieza edificio central")
  nroContratacion    String? // número de contratación asignado
  nroResolucion      String? // número de resolución
  departamentoId     String
  departamento       Departamento @relation(fields: [departamentoId], references: [id])
  area               Area? // sub-área interna de Informática y Varios; no aplica a Servicios
  tipo               String // Informática y Varios: Servicios | Provisiones | Servicios Temporales — Servicios: Ascensores | Termomecánica | Limpieza | Desratización | Servicios Varios / Prevención de Incendios | Matafuegos | Tanques de agua
  agente             String
  organismos         String[]     @default([]) // uno o más organismos solicitantes / destinatarios
  destinatario       String?
  domicilio          String?
  objeto             String
  encuadre           String?
  presupuestoOficial Float        @default(0) // presupuesto oficial estimado
  montoARS           Float        @default(0) // valor adjudicado (ARS)
  montoUSD           Float        @default(0)

  // Policía adicional (contratación interadministrativa con fuerzas de seguridad)
  esPoliciaAdicional     Boolean   @default(false)
  fuerzaSeguridad        String? // PFA | GNA | PNA | PCABA
  cotizacionPolicia      Json? // snapshot de la cotización aprobada y vinculada desde el cotizador
  fechaInicio            DateTime?
  fechaVencimiento       DateTime
  ocResolucion           String? // OC (orden de compra)
  resolucionLlamado      String? // Resolución de llamado
  resolucionAdjudicacion String? // Resolución de adjudicación
  adjudicatario          String?
  sector                 String?
  etapa                  String?
  estadoGeneral          String // Vigente | En trámite de renovación | Finalizado | Archivado
  creadoEn               DateTime  @default(now())
  actualizadoEn          DateTime  @updatedAt

  // Prórroga: opción del propio contrato vigente, no genera un expediente nuevo.
  // Se carga al crear el vigente; se activa después desde la ficha si la
  // renovación se atrasa (extiende fechaVencimiento del mismo registro).
  tieneProrroga    Boolean @default(false)
  prorrogaActivada Boolean @default(false)

  // Parche: contratación puente propia (rol "parche" en la cadena) que cubre
  // el período mientras no hay vigente ni renovación lista. Puede repetirse
  // más de una vez en la misma cadena.
  tipoParche    String? // "Contratación descentralizada" | "Contratación directa por trámite simplificado" | "Legítimo abono"
  detalleParche String?

  // --- Campos exclusivos del departamento Servicios (nullable, sin uso en Informática y Varios) ---
  fuero              String[] @default([]) // ej ["Cámara Federal de Apelaciones de Córdoba"] — puede haber más de uno
  zona               String? // "CABA" | "Interior"
  codigoInterno      String? // código corto de la planilla, ej "02ID", "01LA"
  estadoConvocatoria String? // vocabulario propio de Servicios (string libre, la lista puede crecer)

  observaciones Observacion[]
  documentacion DocumentacionItem[]

  @@index([cadenaId])
  @@index([departamentoId])
  @@index([area])
  @@index([estadoGeneral])
  @@index([nombreCorto])
  @@index([esPoliciaAdicional])
}

model Observacion {
  id             String     @id @default(cuid())
  expedienteId   String
  expediente     Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  fecha          DateTime   @default(now())
  usuario        String
  tipo           String // "general" | "movimiento"
  texto          String
  sectorAnterior String?
  sectorNuevo    String?

  @@index([expedienteId])
}

model DocumentacionItem {
  id           String     @id @default(cuid())
  expedienteId String
  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  item         String
  cargado      Boolean    @default(false)
  orden        Int        @default(0)

  @@index([expedienteId])
}

// ---------- Libro de Aperturas ----------

model Contratacion {
  id            String    @id @default(cuid())
  anio          Int
  numeroOrden   Int
  totalAnual    Int
  expte         String
  organismo     String
  objeto        String
  tipo          String
  fechaCarga    DateTime  @default(now())
  fechaApertura DateTime? // null para tipos sin acto de apertura (Compra Directa, Anticipo de Fondos)
  hora          Int?
  creadoPor     String?
  actualizadoEn DateTime  @updatedAt

  @@unique([anio, numeroOrden])
  @@unique([fechaApertura, hora])
}

model Feriado {
  fecha  DateTime @id
  motivo String
}

model ConfiguracionAnio {
  anio       Int @id
  totalAnual Int
}

// ---------- Valor Modular ----------

model ValorModular {
  id             String   @id @default(cuid())
  valor          Float
  vigenteDesde   DateTime @default(now())
  actualizadoPor String?
}

// ---------- Listado de Teléfonos ----------

model SeccionTelefonica {
  id     String  @id @default(cuid())
  titulo String? // null para las secciones sin encabezado (Aperturas, Mesa de Entradas, etc.)
  orden  Int     @default(0)

  grupos GrupoTelefonico[]
}

model GrupoTelefonico {
  id        String            @id @default(cuid())
  seccionId String
  seccion   SeccionTelefonica @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  rotulo    String
  orden     Int               @default(0)

  personas PersonaTelefono[]

  @@index([seccionId])
}

model PersonaTelefono {
  id      String          @id @default(cuid())
  grupoId String
  grupo   GrupoTelefonico @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nombre  String
  interno String?
  orden   Int             @default(0)

  @@index([grupoId])
}
