// Schema de base de datos real, pensado para Postgres (Vercel Postgres / Neon / Supabase).
// Reemplaza los arrays hardcodeados de lib/constants.js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Departamentos ----------

model Departamento {
  id     String @id @default(cuid())
  nombre String @unique // "Informática y Varios" | "Servicios"
  slug   String @unique // "informatica-y-varios" | "servicios"

  usuarios    Usuario[]
  expedientes Expediente[]
}

// ---------- Usuarios y autenticación ----------

enum Rol {
  admin
  operador
  lector
  soporte
}

model Usuario {
  id             String       @id @default(cuid())
  nombre         String
  email          String       @unique
  passwordHash   String
  rol            Rol
  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  creadoEn       DateTime     @default(now())

  @@index([departamentoId])
}

// ---------- Expedientes ----------

enum Area {
  Informatica
  Varios
}

enum RolCadena {
  antecedente
  vigente
  parche
  renovacion
}

model Expediente {
  id                 String       @id @default(cuid())
  cadenaId           String // agrupa antecedente/vigente/parche/renovación de un mismo trámite
  rol                RolCadena
  exp                String       @unique // "13-06148/26"
  nombreCorto        String? // alias legible para identificar y filtrar rápido ("Limpieza edificio central")
  nroContratacion    String? // número de contratación asignado
  nroResolucion      String? // número de resolución
  departamentoId     String
  departamento       Departamento @relation(fields: [departamentoId], references: [id])
  area               Area? // sub-área interna de Informática y Varios; no aplica a Servicios
  tipo               String // Informática y Varios: Servicios | Provisiones | Servicios Temporales — Servicios: Ascensores | Termomecánica | Limpieza | Desratización | Servicios Varios / Prevención de Incendios | Matafuegos | Tanques de agua
  agente             String
  organismos         String[]     @default([]) // uno o más organismos solicitantes / destinatarios
  destinatario       String?
  domicilio          String?
  objeto             String
  encuadre           String?
  presupuestoOficial Float        @default(0) // presupuesto oficial estimado
  montoARS           Float        @default(0) // valor adjudicado (ARS)
  montoUSD           Float        @default(0)

  // Policía adicional (contratación interadministrativa con fuerzas de seguridad)
  esPoliciaAdicional     Boolean   @default(false)
  fuerzaSeguridad        String? // PFA | GNA | PNA | PCABA
  cotizacionPolicia      Json? // snapshot de la cotización aprobada y vinculada desde el cotizador
  fechaInicio            DateTime?
  fechaVencimiento       DateTime
  fechaPublicacion       DateTime? // publicación del llamado en la convocatoria
  fechaApertura          DateTime? // acto de apertura de la convocatoria
  ocResolucion           String? // OC (orden de compra)
  resolucionLlamado      String? // Resolución de llamado
  resolucionAdjudicacion String? // Resolución de adjudicación
  adjudicatario          String?
  sector                 String?
  etapa                  String?
  estadoGeneral          String // Vigente | En trámite de renovación | Finalizado | Archivado
  creadoEn               DateTime  @default(now())
  actualizadoEn          DateTime  @updatedAt

  // Prórroga: opción del propio contrato vigente. tieneProrroga se tilda al
  // cargar el vigente (o un parche clásico) y ahí mismo se elige el tope
  // total en meses (mesesProrroga, 1/2/3 — no siempre son 3). Ese tope se
  // puede consumir en más de una tanda, sea cual sea la modalidad elegida
  // para activarlo (mutuamente excluyentes entre sí, ver GestionarProrroga):
  //  - la habilita el ORGANISMO: extiende este mismo registro, sin
  //    expediente nuevo y sin orden de compra.
  //  - la habilita el DEPARTAMENTO: genera un expediente "parche" aparte
  //    (una sola vez) que después se subdivide con una OC nueva cada vez,
  //    pero el acumulado se seguí descontando de ESTE registro (el vigente),
  //    no del parche.
  // mesesProrrogaUsados lleva ese acumulado sin importar la modalidad. Cada
  // activación puntual queda registrada en su propia Observacion
  // (mesesProrroga + fechaNotificacionProrroga u ocResolucion de esa tanda).
  // fechaNotificacionProrroga acá es solo la de la última tanda del
  // organismo, para mostrar de un vistazo en la ficha.
  tieneProrroga             Boolean   @default(false)
  mesesProrroga             Int?
  prorrogaActivada          Boolean   @default(false)
  mesesProrrogaUsados       Int       @default(0)
  fechaNotificacionProrroga DateTime?

  // Parche: contratación puente propia (rol "parche" en la cadena) que cubre
  // el período mientras no hay vigente ni renovación lista. Puede repetirse
  // más de una vez en la misma cadena. Un parche es o bien uno "clásico"
  // (tipoParche) o bien una prórroga habilitada por el DEPARTAMENTO
  // (tipoContratacionProrroga) — mutuamente excluyentes.
  tipoParche               String? // "Contratación descentralizada" | "Contratación directa por trámite simplificado" | "Legítimo abono"
  detalleParche            String?
  tipoContratacionProrroga String? // "Contratación descentralizada" | "Licitación Privada" | "Contratación Directa" | "Licitación Pública" | "Trámite Simplificado"
  // true cuando este parche salió de convertir una convocatoria fracasada en
  // descentralizada/trámite simplificado bajo el mismo N° de expediente (ver
  // generarContratacionFracasada) — la ficha lo cuelga junto a la rama
  // fracasada de la que salió, arriba de la línea principal, en vez de
  // mezclarlo con los parches comunes. Como es la misma fila, `encuadre` pasa
  // a ser el de la nueva modalidad — el que tenía la convocatoria fracasada
  // se guarda en encuadreFracasado para poder seguir mostrándolo en esa
  // tarjeta elevada.
  parcheDeFracasada        Boolean  @default(false)
  encuadreFracasado        String?

  // --- Campos exclusivos del departamento Servicios (nullable, sin uso en Informática y Varios) ---
  fuero              String[] @default([]) // ej ["Cámara Federal de Apelaciones de Córdoba"] — puede haber más de uno
  zona               String? // "CABA" | "Interior"
  codigoInterno      String? // código corto de la planilla, ej "02ID", "01LA"
  estadoConvocatoria String? // vocabulario propio de Servicios (string libre, la lista puede crecer)

  // Solo aplica cuando tipo === "Ascensores". tieneAdecuaciones es del
  // expediente completo (además de mantenimiento, incluye obra/adaptación).
  // ascensoresPorDomicilio detalla, para cada domicilio ya cargado en
  // domiciliosRenglones, qué ascensores (1-8) y qué montacargas (1-4)
  // puntuales tramita — { "Talcahuano 550": { "ascensores": [1,2],
  // "montacargas": [1] } }. Domicilios sin entrada no tienen ascensores ni
  // montacargas cargados todavía.
  tieneAdecuaciones      Boolean @default(false)
  ascensoresPorDomicilio Json?

  // Adjudicación parcial: cuando algunos domicilios/renglones de una
  // convocatoria no se adjudican (quedan desiertos/fracasados), se separan en
  // un expediente propio ("Dividir expediente") que referencia de dónde
  // surgió (divisionDeId) sin perder esa relación. Si más adelante los
  // períodos de ambos vuelven a coincidir, se marcan como `unificado` — solo
  // se vinculan visualmente, no se fusionan las filas.
  domiciliosRenglones String[]     @default([])
  // Firma y monto adjudicados por domicilio/renglón:
  // { "domicilio": { "firma": "...", "monto": 1234 } }. Un mismo expediente
  // puede adjudicar distintos renglones a distintas empresas y por distintos
  // montos, por eso no alcanza con `adjudicatario`/`montoARS` (un solo valor
  // para todo el expediente) — se completa al resolver la adjudicación
  // (íntegra o lo que queda adjudicado en una parcial).
  adjudicacionPorRenglon Json?
  divisionDeId        String?
  divisionDe          Expediente?  @relation("DivisionExpediente", fields: [divisionDeId], references: [id])
  divisiones          Expediente[] @relation("DivisionExpediente")
  unificado           Boolean      @default(false)

  // Al día siguiente de la fecha de apertura, se pregunta si se presentaron
  // ofertas: si no, la convocatoria queda "Desierta" y se puede relanzar UNA
  // sola vez con el mismo N° de expediente (misma fila — `exp` es único en
  // la base, no se crea un registro nuevo): mismo N° de contratación si el
  // encuadre es descentralizado, uno nuevo en cualquier otro caso.
  // convocatoriaRelanzada bloquea un segundo relanzamiento si esa segunda
  // convocatoria vuelve a quedar desierta.
  convocatoriaRelanzada Boolean @default(false)

  observaciones Observacion[]
  documentacion DocumentacionItem[]

  @@index([cadenaId])
  @@index([divisionDeId])
  @@index([departamentoId])
  @@index([area])
  @@index([estadoGeneral])
  @@index([nombreCorto])
  @@index([esPoliciaAdicional])
}

model Observacion {
  id             String     @id @default(cuid())
  expedienteId   String
  expediente     Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  fecha          DateTime   @default(now())
  usuario        String
  tipo           String // "general" | "movimiento"
  texto          String
  sectorAnterior String?
  sectorNuevo    String?

  // Detalle estructurado de una activación puntual de prórroga, además del
  // resumen en `texto` — permite reconstruir el historial completo cuando la
  // prórroga se usó en más de una tanda (ver comentario en Expediente.mesesProrrogaUsados).
  mesesProrroga             Int?      // organismo: meses usados en ESTA activación
  fechaNotificacionProrroga DateTime? // organismo: fecha de notificación de ESTA activación
  ocResolucion              String?   // departamento: OC generada en ESTA subdivisión

  @@index([expedienteId])
}

model DocumentacionItem {
  id           String     @id @default(cuid())
  expedienteId String
  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  item         String
  cargado      Boolean    @default(false)
  orden        Int        @default(0)

  @@index([expedienteId])
}

// ---------- Valor Modular ----------

model ValorModular {
  id             String   @id @default(cuid())
  valor          Float
  vigenteDesde   DateTime @default(now())
  actualizadoPor String?
}

// ---------- Listado de Teléfonos ----------

model SeccionTelefonica {
  id     String  @id @default(cuid())
  titulo String? // null para las secciones sin encabezado (Aperturas, Mesa de Entradas, etc.)
  orden  Int     @default(0)

  grupos GrupoTelefonico[]
}

model GrupoTelefonico {
  id        String            @id @default(cuid())
  seccionId String
  seccion   SeccionTelefonica @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  rotulo    String
  orden     Int               @default(0)

  personas PersonaTelefono[]

  @@index([seccionId])
}

model PersonaTelefono {
  id      String          @id @default(cuid())
  grupoId String
  grupo   GrupoTelefonico @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nombre  String
  interno String?
  orden   Int             @default(0)

  @@index([grupoId])
}
