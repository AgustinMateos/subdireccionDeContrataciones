// Schema de base de datos real, pensado para Postgres (Vercel Postgres / Neon / Supabase).
// Reemplaza los arrays hardcodeados de lib/constants.js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Usuarios y autenticación ----------

enum Rol {
  admin
  operador
  lector
  soporte
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol
  creadoEn     DateTime @default(now())
}

// ---------- Expedientes ----------

enum Area {
  Informatica
  Varios
}

enum RolCadena {
  antecedente
  vigente
  renovacion
}

model Expediente {
  id             String   @id @default(cuid())
  cadenaId       String // agrupa antecedente/vigente/renovación de un mismo trámite
  rol            RolCadena
  exp            String   @unique // "13-06148/26"
  nombreCorto    String? // alias legible para identificar y filtrar rápido ("Limpieza edificio central")
  area           Area
  tipo           String // Servicios | Provisiones | Servicios Temporales
  agente         String
  organismo      String
  destinatario   String?
  domicilio      String?
  objeto         String
  encuadre       String?
  montoARS       Float    @default(0)
  montoUSD       Float    @default(0)
  fechaInicio    DateTime?
  fechaVencimiento DateTime
  ocResolucion   String?
  adjudicatario  String?
  sector         String?
  etapa          String?
  estadoGeneral  String // Vigente | En trámite de renovación | Finalizado | Archivado
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  observaciones     Observacion[]
  documentacion     DocumentacionItem[]

  @@index([cadenaId])
  @@index([area])
  @@index([estadoGeneral])
  @@index([nombreCorto])
}

model Observacion {
  id             String   @id @default(cuid())
  expedienteId   String
  expediente     Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  fecha          DateTime @default(now())
  usuario        String
  tipo           String // "general" | "movimiento"
  texto          String
  sectorAnterior String?
  sectorNuevo    String?

  @@index([expedienteId])
}

model DocumentacionItem {
  id           String   @id @default(cuid())
  expedienteId String
  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  item         String
  cargado      Boolean  @default(false)
  orden        Int      @default(0)

  @@index([expedienteId])
}

// ---------- Libro de Aperturas ----------

model Contratacion {
  id            String   @id @default(cuid())
  anio          Int
  numeroOrden   Int
  totalAnual    Int
  expte         String
  organismo     String
  objeto        String
  tipo          String
  fechaCarga    DateTime @default(now())
  fechaApertura DateTime? // null para tipos sin acto de apertura (Compra Directa, Anticipo de Fondos)
  hora          Int?
  creadoPor     String?
  actualizadoEn DateTime @updatedAt

  @@unique([anio, numeroOrden])
  @@unique([fechaApertura, hora])
}

model Feriado {
  fecha  DateTime @id
  motivo String
}

model ConfiguracionAnio {
  anio       Int @id
  totalAnual Int
}

// ---------- Valor Modular ----------

model ValorModular {
  id        String   @id @default(cuid())
  valor     Float
  vigenteDesde DateTime @default(now())
  actualizadoPor String?
}

// ---------- Listado de Teléfonos ----------

model SeccionTelefonica {
  id     String @id @default(cuid())
  titulo String? // null para las secciones sin encabezado (Aperturas, Mesa de Entradas, etc.)
  orden  Int     @default(0)

  grupos GrupoTelefonico[]
}

model GrupoTelefonico {
  id         String @id @default(cuid())
  seccionId  String
  seccion    SeccionTelefonica @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  rotulo     String
  orden      Int    @default(0)

  personas PersonaTelefono[]

  @@index([seccionId])
}

model PersonaTelefono {
  id      String @id @default(cuid())
  grupoId String
  grupo   GrupoTelefonico @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nombre  String
  interno String?
  orden   Int    @default(0)

  @@index([grupoId])
}
